{
  "name": "national-gym-map",
  "version": "1.5.2",
  "private": true,
  "description": "全国健身房地图与个人器械档案",
  "author": "National Gym Map",
  "main": "electron/main.cjs",
  "scripts": {
    "export:shared": "node scripts/export-current-shared.cjs",
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "vite build",
    "build:web": "node scripts/build-web.cjs",
    "preview:web": "vite preview --mode web --host 127.0.0.1",
    "dist": "node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop.cjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "cheerio": "1.0.0",
    "electron-updater": "^6.6.2",
    "fflate": "^0.8.2",
    "gcoord": "^1.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@vitejs/plugin-react": "^4.3.4",
    "7zip-bin": "^5.2.0",
    "electron": "44.2.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.6",
    "rcedit": "^5.0.2",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "cn.nationalgymmap.desktop",
    "productName": "全国健身房地图",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "electron/pdf-import.cjs",
      "node_modules/pdfjs-dist/**/*",
      "node_modules/@napi-rs/**/*"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "browser-capture",
        "to": "browser-capture"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "nsis",
      "artifactName": "NationalGymMap-Setup.exe",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "全国健身房地图",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "player9826",
        "repo": "national-gym-map"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/player9826/national-gym-map.git"
  },
  "homepage": "https://github.com/player9826/national-gym-map"
}
